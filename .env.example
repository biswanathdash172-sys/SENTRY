# SENTRY — environment variables
# Copy this file to .env and fill in real values if you want Postgres
# persistence. If you skip this entirely, the app runs fine in pure
# in-memory demo mode (exactly as before) — nothing below is required.

# Postgres connection string. If unset, unreachable, or malformed, the
# backend automatically and silently falls back to in-memory storage —
# it will NEVER fail to boot because of this value.
# Example: postgresql://sentry_user:sentry_pass@localhost:5432/sentry
DATABASE_URL=

# Set to "true" to force in-memory mode even if DATABASE_URL is valid and
# reachable. Useful to guarantee the judge-safe fallback on demo day
# regardless of DB status.
DEMO_MODE=false