# Copy this to .env (or export these manually) before running locally.
# NEVER commit real values — this file only documents what's needed.

# --- JWT (session tokens issued after a successful Supabase login) ---
JWT_SECRET=change-me
JWT_EXPIRY_SECONDS=86400

# --- Supabase (organizations + employees) ---
# Create the `organizations` and `employees` tables described in
# backend/services/supabase_service.py's module docstring, then fill in:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# --- Gmail IMAP (monitored mailbox) ---
IMAP_HOST=imap.gmail.com
IMAP_USER=your-email@gmail.com
IMAP_APP_PASSWORD=your-app-password
POLL_INTERVAL_SECONDS=30

# --- Poller -> API connection ---
SENTRY_API_BASE=http://localhost:8000

# --- Per-employee poller credentials ---
# Each employee sets THEIR OWN credentials here — NOT shared admin creds.
# Used by: notification_poller.py, device_agent.py, gmail_poller.py, email_poller.py
SENTRY_EMPLOYEE_USERNAME=your-employee-id
SENTRY_EMPLOYEE_PASSWORD=your-employee-password
